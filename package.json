{
  "name": "swipium",
  "mcpName": "io.github.GeroPalombo/swipium",
  "version": "2.4.0",
  "private": false,
  "description": "Swipium MCP server for mobile QA on local Android Emulators and iOS Simulators: autopilot tests, evidence capture, reports, app maps, and generated test suites.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mobile-testing",
    "qa-automation",
    "android-emulator",
    "ios-simulator",
    "appium",
    "ai-agents",
    "test-automation",
    "e2e-testing",
    "react-native-testing",
    "flutter-testing",
    "app-map",
    "test-suites",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "swipium": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "skills",
    "android-agent/prebuilt/swipium-dumper.jar",
    "android-agent/src",
    "android-agent/build.sh",
    "android-agent/README.md",
    "docs",
    "!docs/v1-mvp-plan.md",
    "plugin/README.md",
    "THREAT_MODEL.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GeroPalombo/swipium"
  },
  "bugs": {
    "url": "https://github.com/GeroPalombo/swipium/issues"
  },
  "homepage": "https://swipium.com",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && chmod +x dist/index.js",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "verify": "npm run build && node dist/index.js verify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "release:check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run audit:prod && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
